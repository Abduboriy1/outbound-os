{
  "name": "ai-sales-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx --tsconfig tsconfig.node.json prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "worker": "tsx --tsconfig tsconfig.node.json server/worker/index.ts",
    "postinstall": "prisma generate && nuxt prepare"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@primeuix/themes": "2.0.3",
    "@primevue/forms": "4.5.5",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.9",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pinia": "^4.0.2",
    "primevue": "4.5.5",
    "prisma": "^7.9.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@pinia/nuxt": "^1.0.1",
    "@primevue/nuxt-module": "4.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
